# Server port
PORT=3001

# LLM Provider: copilot | google | openai | anthropic | openai-compatible | demo
# Leave unset or set to "demo" to run the grounded local read-only demo without an API key.
LLM_PROVIDER=copilot

# Optional model override (defaults per provider if omitted):
#   copilot:           gpt-4.1
#   google:            gemini-2.5-flash
#   openai:            gpt-4o
#   anthropic:         claude-sonnet-4-20250514
#   openai-compatible: llama3.2
LLM_MODEL=

# Provider API keys (configure whichever provider you choose)
# GitHub Copilot: auto-detected from ~/.config/github-copilot/{hosts,apps}.json or gh CLI,
# or sign in via Settings -> GitHub Copilot, or set GITHUB_COPILOT_TOKEN here:
GITHUB_COPILOT_TOKEN=
# Optional organizational / Enterprise GitHub domain for Copilot (e.g. company.ghe.com or github.company.com):
GITHUB_COPILOT_DOMAIN=
GOOGLE_GENERATIVE_AI_API_KEY=
# GEMINI_API_KEY is also accepted as an alias for Google Gemini
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# For Ollama, LM Studio, OpenRouter, or any OpenAI-compatible server:
OPENAI_COMPATIBLE_BASE_URL=http://localhost:11434/v1
OPENAI_COMPATIBLE_API_KEY=

# Optional metaphor/concept raster image generation (falls back to clean SVG concept card if unavailable)
IMAGE_GEN_ENABLED=true
GEMINI_IMAGE_MODEL=imagen-3.0-generate-002
OPENAI_IMAGE_MODEL=gpt-image-1
